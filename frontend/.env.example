# Frontend (Vite) environment variables. Values are PUBLIC: they are compiled into the JavaScript bundle. Never put secrets here.
# Copy to .env.local for local overrides; on Vercel set them in Project Settings > Environment Variables.

# Origin of the hosted FastAPI backend (no trailing slash needed), e.g. https://verifai-api.onrender.com
# Leave empty in local development: the Vite dev server proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=
