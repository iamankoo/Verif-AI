# Verif-AI configuration. Copy to backend/.env and adjust. No secrets or API keys are needed:
# all inference is local. Values below are safe defaults / placeholders.

# ---- Model ----
# Checkpoint to serve. Default order: models/verifai_v2_best.pth, then scripts/two_stream_model_epoch_10.pth
VERIFAI_MODEL_PATH=models/verifai_v2_best.pth
# auto | cpu | cuda | cuda:0
VERIFAI_DEVICE=auto

# ---- Storage & privacy ----
VERIFAI_STORAGE_DIR=storage
# Derived evidence images and JSON results are deleted after this many hours (uploads are deleted immediately)
VERIFAI_RESULT_TTL_HOURS=72

# ---- Upload limits ----
VERIFAI_MAX_IMAGE_MB=15
VERIFAI_MAX_VIDEO_MB=200
VERIFAI_MAX_IMAGE_PIXELS=60000000

# ---- Analysis behaviour ----
# |score-0.5| below this is reported INCONCLUSIVE (the 0.5 decision threshold itself is fixed in code)
VERIFAI_UNCERTAINTY_MARGIN=0.15
VERIFAI_VIDEO_SAMPLE_FPS=2.0
VERIFAI_VIDEO_MAX_FRAMES=64
VERIFAI_VIDEO_MAX_DURATION_S=900
# mean | median | weighted_mean | suspicious_fraction
VERIFAI_VIDEO_AGGREGATION=median
VERIFAI_ENABLE_HEATMAPS=true

# ---- Web ----
VERIFAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to the built frontend directory to serve the UI from the API process (done automatically in Docker)
VERIFAI_FRONTEND_DIR=
